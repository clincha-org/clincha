http:
  pprof:
    port: 6060
    enabled: false
  address: 0.0.0.0:3000
  session_ttl: 720h
users:
  - name: {{ adguard_admin_username }}
    password: {{ adguard_admin_password | password_hash('sha512') }}
dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
  upstream_dns:
{% for dns in adguard_upstream_dns %}
    - {{ dns }}
{% endfor %}
  bootstrap_dns:
    - 1.1.1.1
    - 1.0.0.1
  enable_dnssec: true
  cache_size: 4194304
  cache_ttl_min: 0
  cache_ttl_max: 0
  ratelimit: 0
  blocked_response_ttl: 10
  filtering_enabled: true
  parental_enabled: false
  safebrowsing_enabled: false
  safe_search:
    enabled: false
  rewrites:
{% for rewrite in adguard_dns_rewrites %}
    - domain: {{ rewrite.domain }}
      answer: {{ rewrite.answer }}
{% endfor %}
filters:
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
    name: AdGuard DNS filter
    id: 1
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt
    name: AdAway Default Blocklist
    id: 2
querylog:
  enabled: true
  file_enabled: true
  interval: 24h
  size_memory: 1000
statistics:
  enabled: true
  interval: 24h
schema_version: 29
