{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["kubernetes", "flux"],
  "kubernetes": {
    "managerFilePatterns": ["/^kubernetes/flux/.+\\.ya?ml$/"]
  },
  "flux": {
    "managerFilePatterns": ["/^kubernetes/flux/.+\\.ya?ml$/"]
  },
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "ignorePaths": [
    "**/gotk-components.yaml"
  ],
  "packageRules": [
    {
      "description": "Generated by flux install and marked DO NOT EDIT; the flux manager would otherwise regenerate the whole file",
      "matchDepNames": ["fluxcd/flux2"],
      "enabled": false
    },
    {
      "description": "busybox is pinned to no tag, python is a deliberate interpreter pin, and homepage is built and pushed by hand",
      "matchPackageNames": ["busybox", "python", "docker.io/clincha/homepage"],
      "enabled": false
    }
  ]
}
